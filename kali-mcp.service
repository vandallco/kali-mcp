[Unit]
Description=kali-mcp (servidor MCP para Claude)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajusta User y rutas a tu usuario de Kali:
User=kali
WorkingDirectory=/opt/kali-mcp
# Token y configuración en un archivo aparte con permisos 600 (ver README):
EnvironmentFile=/etc/kali-mcp.env
ExecStart=/opt/kali-mcp/.venv/bin/python /opt/kali-mcp/server.py
Restart=on-failure
RestartSec=3
# Endurecimiento básico de systemd
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
