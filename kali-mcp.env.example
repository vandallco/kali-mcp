# Copiar a /etc/kali-mcp.env y ejecutar: sudo chmod 600 /etc/kali-mcp.env
# Generar un token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KALI_MCP_TOKEN=cambiar-por-un-token-largo-y-aleatorio
KALI_MCP_HOST=127.0.0.1
KALI_MCP_PORT=8765
KALI_MCP_WORKDIR=/home/kali
# Opcional: solo estos binarios en run_command/start_task
# KALI_MCP_ALLOWED_COMMANDS=nmap,whois,dig,curl,grep
# Opcional: si escuchás en la LAN, hosts permitidos (protección DNS rebinding)
# KALI_MCP_ALLOWED_HOSTS=192.168.1.50:*
